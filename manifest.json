{
  "manifest_version": 3,
  "name": "每日签到 · 烧饼与 NodeSeek",
  "version": "0.1.7",
  "description": "每天定时尝试签到，也可一键运行；需要登录或机器人验证时提醒手动处理。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["notifications"],
  "host_permissions": ["https://sb.sb/*", "https://www.nodeseek.com/*"],
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "action": {
    "default_title": "每日签到",
    "default_popup": "ui/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_page": "ui/options.html",
  "content_scripts": [
    {
      "matches": ["https://sb.sb/checkin", "https://sb.sb/checkin/", "https://sb.sb/checkin?*", "https://sb.sb/checkin/?*"],
      "js": ["shared/core.js", "content/dom.js", "content/sb.js", "content/common.js"],
      "run_at": "document_idle", "all_frames": false
    },
    {
      "matches": ["https://www.nodeseek.com/board", "https://www.nodeseek.com/board/", "https://www.nodeseek.com/board?*", "https://www.nodeseek.com/board/?*"],
      "js": ["shared/core.js", "content/dom.js", "content/nodeseek.js", "content/common.js"],
      "run_at": "document_idle", "all_frames": false
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none';" }
}
